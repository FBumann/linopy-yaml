\documentclass[11pt]{article}
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage[margin=2.5cm]{geometry}
\allowdisplaybreaks
\begin{document}

\paragraph{Sets}
\begin{description}
\item[$\mathcal{T}$] index $t$ --- \texttt{snapshot}
\item[$\mathcal{G}$] index $g$ --- \texttt{generator} with $\mathrm{gen\_bus}: \mathcal{G} \to \mathcal{B}$
\item[$\mathcal{B}$] index $b$ --- \texttt{bus} with $\mathrm{zone\_of}: \mathcal{B} \to \mathcal{Z}$
\item[$\mathcal{Z}$] index $z$ --- \texttt{zone}
\end{description}

\paragraph{Parameters}
\begin{description}
\item[$p^{\mathrm{max}}$] \texttt{p\_max} over $\mathcal{G}$
\item[$p^{\mathrm{min}}$] \texttt{p\_min} over $\mathcal{G}$
\item[$\mathit{cost}$] \texttt{cost} over $\mathcal{G}$
\item[$\mathit{load}$] \texttt{load} over $\mathcal{T} \times \mathcal{B}$
\item[$\mathit{is\_flexible}$] \texttt{is\_flexible} over $\mathcal{G}$
\item[$\mathit{zone}^{\mathrm{cap}}$] \texttt{zone\_cap} over $\mathcal{Z}$
\end{description}

\paragraph{Variables}
\begin{description}
\item[$p$] \texttt{p} over $\mathcal{T} \times \mathcal{G}$
\item[$\mathit{spill}$] \texttt{spill} over $\mathcal{T}$
\item[$\mathit{slack}$] \texttt{slack} over $\mathcal{T}$
\item[$\mathit{theta}$] \texttt{theta} over $\mathcal{B}$
\item[$\mathit{on}$] \texttt{on} over $\mathcal{T} \times \mathcal{G}$
\item[$\mathit{units}$] \texttt{units} over $\mathcal{G}$
\end{description}

\noindent $t \ominus k$ denotes cyclic translation: index $t-k$ taken modulo the size of the dimension (\texttt{roll}). Plain $t-k$ (\texttt{shift}) has no wraparound --- terms translated past the edge are simply absent.

\noindent $t \boxminus_{v} k$ denotes translation with $v$ standing where index $t-k$ leaves the dimension (\texttt{shift(edge=v)}), so the row at that boundary is built and carries $v$ rather than being dropped.

\paragraph{Objective}
\begin{align}
 && \max & \sum_{t \in \mathcal{T},\ g \in \mathcal{G}} p_{t,g} \cdot \mathit{cost}_{g}
\end{align}

\paragraph{Subject to}
\begin{align}
\text{balance} && \sum_{g \in \mathcal{G} \,:\, \mathrm{gen\_bus}(g) = b} p_{t,g} + \mathit{spill}_{t} - \mathit{slack}_{t} & = \mathit{load}_{t,b} && \forall\, t \in \mathcal{T},\ b \in \mathcal{B} \\
\text{ramp} && p_{t,g} - p_{t \ominus 1,g} & \le p_{t - 1,g} + p^{\mathrm{max}}_{g} && \forall\, t \in \mathcal{T},\ g \in \mathcal{G} \\
\text{edges} && p_{t \boxminus_{0} 1,g} & \le p_{t \boxplus_{0} 1,g} + p^{\mathrm{max}}_{g} && \forall\, t \in \mathcal{T},\ g \in \mathcal{G} \\
\text{pullback} && \mathit{spill}_{t} & \le \mathit{zone}^{\mathrm{cap}}_{\mathrm{zone\_of}(b)} && \forall\, t \in \mathcal{T},\ b \in \mathcal{B} \\
\text{arithmetic} && \sum_{g \in \mathcal{G}} \left( \frac{p_{t,g}}{2} + -\mathit{cost}_{g} \right) & \ge \left( -\left( \sum_{g \in \mathcal{G}} p_{t,g} \right) \right) \cdot 3 && \forall\, t \in \mathcal{T}
\end{align}

\paragraph{Variable domains}
\begin{align}
\text{p} && p^{\mathrm{min}}_{g} \le p_{t,g} & \le p^{\mathrm{max}}_{g} && \forall\, t \in \mathcal{T},\ g \in \mathcal{G} \,:\, \left( p^{\mathrm{max}}_{g} > 0 \wedge \neg \mathit{is\_flexible}_{g} \text{ is defined} \vee p^{\mathrm{min}}_{g} > 0 \right) \\
\text{spill} && \mathit{spill}_{t} & \ge 0 && \forall\, t \in \mathcal{T} \\
\text{slack} && \mathit{slack}_{t} & \le 100 && \forall\, t \in \mathcal{T} \\
\text{theta} && \mathit{theta}_{b} & \in \mathbb{R} && \forall\, b \in \mathcal{B} \\
\text{on} && \mathit{on}_{t,g} & \in \{0, 1\} && \forall\, t \in \mathcal{T},\ g \in \mathcal{G} \\
\text{units} && 0 \le \mathit{units}_{g} & \le 10, \mathit{units}_{g} \in \mathbb{Z} && \forall\, g \in \mathcal{G}
\end{align}

\end{document}
